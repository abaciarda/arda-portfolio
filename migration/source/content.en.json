          "_type": "block",
          "_key": "source-35",
          "style": "normal",
          "markDefs": [],
          "children": [
            {
              "_type": "span",
              "_key": "source-36",
              "text": "@theme",
              "marks": [
                "code"
              ]
            },
            {
              "_type": "span",
              "_key": "source-37",
              "text": " makes each variable available as both a CSS custom property and a Tailwind utility class.",
              "marks": []
