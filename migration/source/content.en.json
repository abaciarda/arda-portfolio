              "_type": "span",
              "_key": "source-31",
              "text": " ",
              "marks": []
            },
            {
              "_type": "span",
              "_key": "source-32",
              "text": "@tailwindcss/vite",
              "marks": [
                "code"
              ]
            },
            {
              "_type": "span",
              "_key": "source-33",
              "text": " plugin instead of a PostCSS setup.",
              "marks": []
            }
          ]
        },
        {
          "_type": "block",
